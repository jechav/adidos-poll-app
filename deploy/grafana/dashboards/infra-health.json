{
  "title": "Infra Health",
  "description": "I-019: queue depth, Redis hit rate, shard/cluster status, and reconciliation drift, built from I-017's metric catalog. See docs/issues/I-019-alerting.md.",
  "tags": ["poll-app", "infra"],
  "timezone": "utc",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Queue Depth",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "poll_queue_depth", "legendFormat": "{{queue}}" }
      ],
      "thresholds": [
        { "value": 5000, "colorMode": "warning", "op": "gt", "label": "Warning: > 5,000" },
        { "value": 10000, "colorMode": "critical", "op": "gt", "label": "Critical: > 10,000 (spec threshold)" }
      ]
    },
    {
      "id": 2,
      "title": "Redis Hit Rate %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(poll_redis_cache_hits_total[5m])) / (sum(rate(poll_redis_cache_hits_total[5m])) + sum(rate(poll_redis_cache_misses_total[5m])))",
          "legendFormat": "hit rate"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "thresholds": [
        { "value": 0.97, "colorMode": "warning", "op": "lt", "label": "Warning: < 97%" },
        { "value": 0.95, "colorMode": "critical", "op": "lt", "label": "Critical: < 95% (spec threshold)" }
      ]
    },
    {
      "id": 3,
      "title": "Redis Cluster Node Status",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "description": "Up/down per Redis Cluster node (I-002).",
      "targets": [
        { "refId": "A", "expr": "up{job=\"redis-cluster\"}", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 4,
      "title": "PostgreSQL Shard Status",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "description": "Up/down and write latency per shard (I-001/I-008).",
      "targets": [
        { "refId": "A", "expr": "up{job=\"postgres-shard\"}", "legendFormat": "shard {{shard}}" },
        { "refId": "B", "expr": "pg_stat_activity_write_latency_seconds", "legendFormat": "write latency shard {{shard}}" }
      ]
    },
    {
      "id": 5,
      "title": "Reconciliation Drift",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "description": "Last hourly run's worst per-poll drift ratio (I-017's src/jobs/reconciliation.py).",
      "targets": [
        { "refId": "A", "expr": "poll_reconciliation_drift_max_ratio", "legendFormat": "max drift ratio" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "thresholds": [
        { "value": 0.005, "colorMode": "warning", "op": "gt", "label": "Warning: > 0.5%" },
        { "value": 0.01, "colorMode": "critical", "op": "gt", "label": "Critical: > 1% (spec threshold)" }
      ]
    },
    {
      "id": 6,
      "title": "DB Constraint Violation Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "rate(poll_db_constraint_violations_total[5m]) * 60", "legendFormat": "violations/min ({{shard}})" }
      ],
      "thresholds": [
        { "value": 0, "colorMode": "warning", "op": "gt", "label": "Warning: any occurrence" },
        { "value": 5, "colorMode": "critical", "op": "gt", "label": "Critical: sustained > 5/min" }
      ]
    }
  ]
}
